{
  "manifest_version": 3,
  "name": "LoveToolbox - 运营自动化悬浮球",
  "version": "1.3.12",
  "description": "纯文案模式保留逐创意切换和当次填写确认，移除全部处理后的逐个回访；其他功能不变。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ]
    },
    {
      "matches": [
        "https://ad.vivo.com.cn/marketing/*"
      ],
      "js": [
        "workflow/media-store.js",
        "workflow/creative-detect.js",
        "workflow/content-workflow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "workflow/background.js"
  }
}
