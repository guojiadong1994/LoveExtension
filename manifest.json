{
  "manifest_version": 3,
  "name": "LoveToolbox - vivo 广告自动化工具",
  "version": "1.3.48",
  "description": "批量创建预览图改为直接选择图片，仅用于激励互动竖版视频；一键素材+文案保留原有通用预览图逻辑。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "debugger"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ]
    },
    {
      "matches": [
        "https://ad.vivo.com.cn/marketing/*"
      ],
      "js": [
        "workflow/media-store.js",
        "workflow/creative-detect.js",
        "workflow/horizontal-preview.js",
        "workflow/content-workflow.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ad.vivo.com.cn/marketing/*"
      ],
      "js": [
        "batch-create/catalog.js",
        "batch-create/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "batch-create/worker-entry.js"
  }
}
