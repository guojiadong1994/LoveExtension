{
  "manifest_version": 3,
  "name": "LoveToolbox - 运营自动化悬浮球",
  "version": "1.3.42",
  "description": "批量新建支持信息流展现形式；保存/提交遇到 vivo 明确表单错误立即暂停并允许继续任务。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "debugger"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ]
    },
    {
      "matches": [
        "https://ad.vivo.com.cn/marketing/*"
      ],
      "js": [
        "workflow/media-store.js",
        "workflow/creative-detect.js",
        "workflow/horizontal-preview.js",
        "workflow/content-workflow.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ad.vivo.com.cn/marketing/*"
      ],
      "js": [
        "batch-create/catalog.js",
        "batch-create/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "batch-create/worker-entry.js"
  }
}
