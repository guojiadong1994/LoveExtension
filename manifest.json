{
  "manifest_version": 3,
  "name": "LoveToolbox - 运营自动化悬浮球",
  "version": "1.3.15",
  "description": "两种上传入口支持最多10张横版预览图，按创意逐一对应；只保存文件访问句柄。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ]
    },
    {
      "matches": [
        "https://ad.vivo.com.cn/marketing/*"
      ],
      "js": [
        "workflow/media-store.js",
        "workflow/creative-detect.js",
        "workflow/horizontal-preview.js",
        "workflow/content-workflow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "workflow/background.js"
  }
}
